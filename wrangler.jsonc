{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rmm-uchet",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [{ "binding": "DB", "database_name": "rmm-uchet-db", "database_id": "REPLACE_WITH_D1_DATABASE_ID" }]
}
