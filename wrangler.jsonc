{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rmm-uchet",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rmm-uchet-db",
      "database_id": "f2b94c7e-4f09-41d2-bd82-6af3c7892f21"
    }
  ]
}
